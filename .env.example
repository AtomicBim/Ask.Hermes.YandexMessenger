# Copy to .env (never commit it) and fill in. Used by docker-compose.yml.

# --- Yandex Messenger -------------------------------------------------------
# OAuth token of the bot (admin.yandex.ru/bot-platform). One token = one polling gateway.
YANDEX_MESSENGER_BOT_TOKEN=
# Comma-separated logins allowed to talk to the bot. Without it (and without ALLOW_ALL) nobody is authorized.
YANDEX_MESSENGER_ALLOWED_USERS=
# Administrators (comma-separated logins). ONLY they can run /model, /config, /yolo, /reasoning, /tools, /skills,
# /update ... and press the model-picker buttons. Everybody else keeps chat plus the commands in USER_COMMANDS.
# EMPTY = NO RESTRICTION: every allowed user can change the model. Set it for any shared bot.
YANDEX_MESSENGER_ADMIN_USERS=
# Commands for non-admins when ADMIN_USERS is set (/help and /whoami are always allowed). Default:
# new,stop,status,retry,undo,history,title,resume,sessions,queue,usage,approve,deny,version
# YANDEX_MESSENGER_USER_COMMANDS=
# YANDEX_MESSENGER_ALLOW_ALL_USERS=false
# YANDEX_MESSENGER_ALLOWED_CHATS=
# YANDEX_MESSENGER_REQUIRE_MENTION=true
# YANDEX_MESSENGER_HOME_CHANNEL=chat:<id>        # default chat for cron / notifications

# Webhook mode instead of polling (needs a public HTTPS URL, see README):
# YANDEX_MESSENGER_WEBHOOK_URL=https://bot.example.com
# YANDEX_MESSENGER_WEBHOOK_SECRET=
# YANDEX_MESSENGER_WEBHOOK_PORT=8647

# --- API keys for the models in config/hermes.yaml ---------------------------
# OpenRouter: chat model, sub-agents, vision, image generation
OPENROUTER_API_KEY=
# Groq: stt (voice recognition)
GROQ_API_KEY=
# Google AI Studio: tts (voice output)
GEMINI_API_KEY=

# Models and the rest of Hermes' settings live in config/hermes.yaml (+ private config/hermes.local.yaml).
# Users cannot change the model themselves when ADMIN_USERS is set; the admin changes it by editing
# config/hermes.yaml (+ `docker compose restart hermes`) or with `docker compose exec hermes hermes model`.
# Optional: force the main model on EVERY start (wins over the seed and over `hermes model`):
# HERMES_PROVIDER=openrouter
# HERMES_MODEL=~deepseek/deepseek-pro-latest
# Re-apply the seed even though it did not change (undoes manual `hermes config set` changes):
# HERMES_CONFIG_RESEED=1

# --- Outbound proxy / VPN ---------------------------------------------------
# Hermes tools (Gemini TTS, Groq STT, LLM calls) honour the standard variables. Yandex is a Russian service and
# is kept DIRECT by default through NO_PROXY (.yandex.net,.yandex.ru - set in docker-compose.yml).
# VPN client on the Docker host (it must listen on 0.0.0.0 / the docker bridge, not only on 127.0.0.1):
# HTTP_PROXY=http://host.docker.internal:20172
# HTTPS_PROXY=http://host.docker.internal:20172
# or a remote proxy: http://user:pass@vpn-host:3128, socks5h://host:1080 (aiohttp_socks is present in the image)
# If you set NO_PROXY yourself it REPLACES the default, so keep the Yandex domains (and internal hosts) in it:
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,.yandex.net,.yandex.ru
# Route ONLY the Yandex bot through a proxy (wins over HTTPS_PROXY and NO_PROXY):
# YANDEX_MESSENGER_PROXY=http://user:pass@proxy-host:3128

# --- Hermes version (pinned) ---------------------------------------------------
# The plugin uses Hermes internals, so the image is pinned to the release it was tested against. A rebuild never
# moves to a newer Hermes by itself; to upgrade, change this tag and follow README "Обновление Hermes".
# Do NOT use `latest` or `stable`: they move without notice.
HERMES_IMAGE=nousresearch/hermes-agent:v0.23.1
